<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <RootNamespace>Interop.BugTraqProvider</RootNamespace>
    <AssemblyName>IPlugin</AssemblyName>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- 与 build.ps1 保持一致：接口独立程序集，插件与调用方共用同一份 -->
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <!-- 只编译 COM 接口定义（src\Interop），插件代码归 TsvnAiCommitMessage 工程 -->
    <Compile Remove="**\*.cs" />
    <Compile Include="src\Interop\**\*.cs" />
  </ItemGroup>

</Project>
