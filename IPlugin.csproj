<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <RootNamespace>Interop.BugTraqProvider</RootNamespace>
    <AssemblyName>IPlugin</AssemblyName>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- 与 build.ps1 保持一致：接口独立程序集，插件与调用方共用同一份 -->
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <!-- 默认通配已包含目录下全部 .cs，排除插件工程的文件，只保留接口 -->
    <Compile Remove="src\AiCommitMessageProvider.cs" />
    <Compile Remove="src\WorkBuddyAgentClient.cs" />
    <Compile Remove="src\GenerationDialog.cs" />
  </ItemGroup>

</Project>
