<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <RootNamespace>TsvnAiCommitMessage</RootNamespace>
    <AssemblyName>TsvnAiCommitMessage</AssemblyName>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <!-- 插件主程序集：src 下按模块分目录（Plugin/Agent/Svn/UI/Core/Tools/Common），
         Interop 目录的 COM 接口归 IPlugin 工程，保持两个程序集边界 -->
    <Compile Remove="**\*.cs" />
    <Compile Include="src\**\*.cs" />
    <Compile Remove="src\Interop\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <!-- 桥接脚本随 DLL 发布，运行时按 DLL 所在目录定位；
         SDK 默认已包含该文件为 None，先 Remove 去重再加元数据 -->
    <None Remove="agent-bridge\codebuddy-bridge.js" />
    <None Include="agent-bridge\codebuddy-bridge.js">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="IPlugin.csproj" />
  </ItemGroup>

</Project>
